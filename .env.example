# Same AWS account as milos-club-be (725921554236, us-east-2).
# Copy this file to .env, .env.staging, and .env.production.
AWS_PROFILE=aws-milos-pet-club
AWS_REGION=us-east-2

# Comma-separated Google OAuth client IDs accepted by POST /api/auth/social.
# The web app's Google Identity Services client id belongs here.
# Loaded at synth/deploy time and baked into the social sign-in Lambda.
GOOGLE_CLIENT_IDS=

# WhatsApp webhook credentials are not in .env.
# CDK creates Secrets Manager secret RespondiBeStack-{env}-whatsapp-webhook
# with keys verifyToken and appSecret (initially REPLACE_ME). Update them in the console.
